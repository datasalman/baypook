# BayPook environment. Copy to .env.local for local live/test-mode runs.
# `npm run demo` needs none of these.

# Set BAYPOOK_DEMO_SAMPLE=0 to start demo mode without the sample bookings.
# demo | live  (default live). Demo boots an embedded Postgres (PGlite) under .data/demo and fakes payments, email and calendar.
BAYPOOK_MODE=live

# Live mode only. Postgres connection string (Neon or Supabase). See SETUP.md step 4.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Live mode only. Long random string (32+ chars) used to sign sessions and magic links. `openssl rand -hex 32`
APP_SECRET=

# Public URL of this BayPook deployment, used in emails and Stripe return URLs. No trailing slash.
BAYPOOK_URL=http://localhost:3000

# Comma-separated origins allowed to call /api/v1 (the Slimedom website) and to receive Stripe return URLs.
# Demo mode implies http://localhost:3000 and :3100; live mode allows only what is listed here.
ALLOWED_ORIGINS=https://slimedom.com,https://www.slimedom.com

# Stripe: one account per venue. Suffix = venue slug upper-cased with hyphens as underscores.
# Test keys (sk_test_…) give Stripe test mode; live keys (sk_live_…) go live. See SETUP.md step 1.
STRIPE_SECRET_KEY__SOUTH_WOODFORD=
STRIPE_WEBHOOK_SECRET__SOUTH_WOODFORD=
STRIPE_SECRET_KEY__LAKESIDE=
STRIPE_WEBHOOK_SECRET__LAKESIDE=

# Resend for email. EMAIL_FROM must be on a verified domain. See SETUP.md step 2.
RESEND_API_KEY=
EMAIL_FROM="Slimedom <bookings@book.slimedom.com>"
# Where owner alerts (new party, cancellations) go. Defaults to the organisation contact email.
OWNER_ALERT_EMAIL=

# Google Calendar mirror. The whole service-account JSON on one line (or base64 with GOOGLE_SERVICE_ACCOUNT_JSON_BASE64). See SETUP.md step 3.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Protects /api/cron/* . Vercel sends it as `Authorization: Bearer <CRON_SECRET>`. `openssl rand -hex 24`
CRON_SECRET=

# Optional: where the booking website lives; /book/thanks on it receives Stripe returns. Defaults to BAYPOOK_URL (the reference page).
WEBSITE_URL=
